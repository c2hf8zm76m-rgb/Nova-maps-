  for(const query of queries){try{const j=await ytmPost('search',{query});const rows=allObjects(j,o=>!!o.musicResponsiveListItemRenderer).map(o=>o.musicResponsiveListItemRenderer);let checked=0;for(const r of rows){if(checked++>35)break;const runs=rendererRuns(r);const eps=endpointsFromRuns(runs);const cols=(r.flexColumns||[]).map(c=>textOf(c.musicResponsiveListItemFlexColumnRenderer?.text)).filter(Boolean);const rowText=runs.map(x=>x.text||'').join(' ');const title=cols[0]||runs[0]?.text||'';const ts=sim(title,input.title);const as=sim(rowText,input.artist);const albumEp=eps.find(e=>e.type==='browse'&&(e.pageType==='MUSIC_PAGE_TYPE_ALBUM'||/^MPRE/i.test(e.id)));if(!albumEp||seen.has(albumEp.id))continue;if(ts<.55&&!(evidence.albumHint&&sim(rowText,evidence.albumHint)>.7))continue;if(as<.25&&meaningfulArtist(input.artist))continue;seen.add(albumEp.id);const a=await ytmAlbum(albumEp.id);const proof=trackProof(a.tracks,input);a.score=70+ts*18+as*10+(proof.ok?15:0)+(evidence.albumHint?sim(a.title,evidence.albumHint)*18:0)-badEditionPenalty(a.title,input.title,evidence.albumHint);a.reason=proof.ok?'YouTube Music Canonical Song':'YouTube Music Album Relation';out.push(a);if(out.length>=5)break;}}catch(e){evidence.errors.push(`ytmusic-search:${e.message}`)}}
  return out;
}
function uniqStrings(a){return [...new Set((a||[]).map(safe).filter(Boolean))];}

async function youtubeEvidence(input){const ev={title:cleanTitle(input.title),artist:cleanArtist(input.artist),description:safe(input.description),albumHint:'',rawTitle:safe(input.title),rawArtist:safe(input.artist),errors:[]};
  if(input.videoId){try{const j=await ytmPost('player',{videoId:input.videoId});const vd=j?.videoDetails||{};const mf=j?.microformat?.playerMicroformatRenderer||{};if(vd.title)ev.title=cleanTitle(vd.title);if(vd.author)ev.artist=cleanArtist(vd.author);ev.description=vd.shortDescription||mf.description?.simpleText||ev.description;ev.durationMs=Number(vd.lengthSeconds||0)*1000||input.durationMs||0;}catch(e){ev.errors.push(`video-details:${e.message}`)}}
  ev.albumHint=extractAlbumHint(`${ev.description}\n${input.description||''}`);return ev;}

async function resolveDeezer(input,evidence){const out=[];try{const qv=encodeURIComponent(`${input.artist} ${input.title}`);const sr=await fetchJson(`https://api.deezer.com/search/track?q=${qv}&limit=25`);let artistSeeds=[];for(const t of sr.data||[]){const ts=sim(t.title,input.title),as=sim(t.artist?.name,input.artist);if(ts>=.55&&as>=.35)artistSeeds.push({id:t.artist?.id,name:t.artist?.name,score:ts*60+as*40});}
  if(!artistSeeds.length&&input.artist){const ar=await fetchJson(`https://api.deezer.com/search/artist?q=${encodeURIComponent(input.artist)}&limit=12`);artistSeeds=(ar.data||[]).map(a=>({id:a.id,name:a.name,score:sim(a.name,input.artist)*100})).filter(a=>a.score>=50)}
  artistSeeds=dedupe(artistSeeds,x=>x.id).sort((a,b)=>b.score-a.score).slice(0,3);
  for(const seed of artistSeeds){let disc;try{disc=await fetchJson(`https://api.deezer.com/artist/${seed.id}/albums?limit=100`)}catch{continue}const albums=(disc.data||[]).filter(a=>a.id).map(a=>({id:a.id,title:a.title,trackCount:a.nb_tracks||0,cover:a.cover_xl||a.cover_big||a.cover_medium||'',artist:a.artist?.name||seed.name,year:pickYear(a.release_date),type:a.record_type||''}));
    const ranked=albums.map(a=>({a,pre:(evidence.albumHint?sim(a.title,evidence.albumHint)*55:0)-badEditionPenalty(a.title,input.title,evidence.albumHint)+(a.trackCount>1?12:-24)})).sort((x,y)=>y.pre-x.pre).slice(0,18);
    for(const {a} of ranked){let detail;try{detail=await fetchJson(`https://api.deezer.com/album/${a.id}`)}catch{continue}const albumArtist=detail.artist?.name||a.artist;if(sim(albumArtist,input.artist)<.32&&meaningfulArtist(input.artist))continue;if(/various artists/i.test(albumArtist))continue;const tracks=(detail.tracks?.data||[]).map(t=>({title:t.title_short||t.title,artist:t.artist?.name||albumArtist,durationMs:Number(t.duration||0)*1000,deezerId:String(t.id||'')}));const proof=trackProof(tracks,input);if(!proof.ok)continue;const trackCount=Number(detail.nb_tracks)||tracks.length;let score=60+proof.total*.45+sim(albumArtist,input.artist)*18+(evidence.albumHint?sim(detail.title,evidence.albumHint)*24:0)+(trackCount>1?15:-35)-badEditionPenalty(detail.title,input.title,evidence.albumHint);out.push(albumBase('deezer',{id:String(detail.id),title:detail.title,artist:albumArtist,year:pickYear(detail.release_date),cover:detail.cover_xl||detail.cover_big||a.cover,tracks,trackCount,score,reason:'Deezer Artist Discography Canonical Album',meta:{proof}}));if(out.length>=6)break;}
    if(out.length>=6)break;
  }}catch(e){evidence.errors.push(`deezer:${e.message}`)}return out.sort((a,b)=>b.score-a.score).slice(0,6);}

async function appleSearch(term,country){return fetchJson(`https://itunes.apple.com/search?term=${encodeURIComponent(term)}&country=${country}&media=music&entity=song&limit=50`)}
async function appleLookup(id,country){return fetchJson(`https://itunes.apple.com/lookup?id=${encodeURIComponent(id)}&country=${country}&entity=song&limit=200`)}
async function resolveApple(input,evidence){const seeds=new Map();const variants=uniqStrings([evidence.albumHint?`${input.artist} ${evidence.albumHint}`:'',`${input.artist} ${input.title}`,input.title]);
  for(const country of ['FR','US'])for(const term of variants){try{const j=await appleSearch(term,country);for(const r of j.results||[]){if(r.wrapperType!=='track'||!r.collectionId)continue;const ts=sim(r.trackName,input.title),as=sim(r.artistName,input.artist),hs=evidence.albumHint?sim(r.collectionName,evidence.albumHint):0;if(ts<.45&&hs<.6)continue;if(as<.25&&meaningfulArtist(input.artist))continue;const score=ts*55+as*30+hs*35+(country==='FR'?2:0)-badEditionPenalty(r.collectionName,input.title,evidence.albumHint);const prev=seeds.get(r.collectionId);if(!prev||prev.score<score)seeds.set(r.collectionId,{id:r.collectionId,country,score,name:r.collectionName})}}catch(e){evidence.errors.push(`apple-search:${e.message}`)}}
