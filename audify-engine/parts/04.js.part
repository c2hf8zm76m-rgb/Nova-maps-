  const out=[];for(const seed of [...seeds.values()].sort((a,b)=>b.score-a.score).slice(0,10)){try{const j=await appleLookup(seed.id,seed.country);const collection=(j.results||[]).find(r=>r.wrapperType==='collection')||{};const songs=(j.results||[]).filter(r=>r.wrapperType==='track').map(r=>({title:r.trackName,artist:r.artistName,durationMs:r.trackTimeMillis||0,discNumber:r.discNumber||1,trackNumber:r.trackNumber||0,appleTrackId:String(r.trackId||'')}));const artist=collection.artistName||songs[0]?.artist||input.artist;if(sim(artist,input.artist)<.30&&meaningfulArtist(input.artist))continue;const proof=trackProof(songs,input);if(!proof.ok)continue;const title=collection.collectionName||seed.name;const trackCount=Number(collection.trackCount)||songs.length;let score=58+seed.score*.42+proof.total*.48+(evidence.albumHint?sim(title,evidence.albumHint)*28:0)+(trackCount>1?14:-40)-badEditionPenalty(title,input.title,evidence.albumHint);out.push(albumBase('apple',{id:String(seed.id),title,artist,year:pickYear(collection.releaseDate),cover:image600(collection.artworkUrl100||collection.artworkUrl60||''),tracks:songs,trackCount,score,reason:evidence.albumHint&&sim(title,evidence.albumHint)>.84?'Apple Hint Exact Early Stop':'Apple/iTunes Release Graph + Tracklist Proof',meta:{proof,country:seed.country}}));if(out[0]?.score>120&&evidence.albumHint&&sim(title,evidence.albumHint)>.9)break;}catch(e){evidence.errors.push(`apple-lookup:${e.message}`)}}return out.sort((a,b)=>b.score-a.score).slice(0,6);}

async function mbGet(path){return fetchJson(`https://musicbrainz.org/ws/2/${path}${path.includes('?')?'&':'?'}fmt=json`,{headers:{'User-Agent':UA,'Accept':'application/json'}},10000)}
function mbArtist(ac){return (ac||[]).map(x=>x.name||x.artist?.name||'').filter(Boolean).join(', ')}
function mbTracksFromRelease(j){const out=[];for(const m of j.media||[])for(const tr of m.tracks||[]){const rec=tr.recording||{};out.push({title:rec.title||tr.title,artist:mbArtist(rec['artist-credit']||tr['artist-credit']||j['artist-credit']),durationMs:Number(tr.length||rec.length||0),discNumber:m.position||1,trackNumber:tr.position||0,recordingId:rec.id||''});}return out;}
async function mbLoadRelease(id,input,evidence,reason,base=0){const j=await mbGet(`release/${encodeURIComponent(id)}?inc=recordings+artist-credits+release-groups`);const tracks=mbTracksFromRelease(j);const artist=mbArtist(j['artist-credit'])||input.artist;const proof=trackProof(tracks,input);if(!proof.ok)return null;const status=j.status||'';const primary=j['release-group']?.['primary-type']||'';const secondary=j['release-group']?.['secondary-types']||[];let score=base+54+proof.total*.45+(status==='Official'?10:0)+(primary==='Album'?18:0)+(tracks.length>1?12:-35)-(secondary.some(x=>/Compilation|Live/i.test(x))?20:0)-badEditionPenalty(j.title,input.title,evidence.albumHint)+(evidence.albumHint?sim(j.title,evidence.albumHint)*24:0);return albumBase('musicbrainz',{id:j.id,title:j.title,artist,year:pickYear(j.date),cover:`https://coverartarchive.org/release/${j.id}/front-500`,tracks,trackCount:tracks.length,score,reason,meta:{proof,status,primaryType:primary,secondaryTypes:secondary}});}
async function resolveMusicBrainz(input,evidence){const out=[];const relIds=[];
  if(input.videoId){for(const resource of [`https://www.youtube.com/watch?v=${input.videoId}`,`https://youtu.be/${input.videoId}`]){try{const j=await mbGet(`url?resource=${encodeURIComponent(resource)}&inc=recording-rels`);for(const rel of j.relations||[]){const rec=rel.recording||rel.target?.recording;if(rec?.id)relIds.push(rec.id);}}catch(e){evidence.errors.push(`mb-url:${e.message}`)}}}
  for(const rid of uniqStrings(relIds).slice(0,4)){try{const r=await mbGet(`recording/${rid}?inc=artist-credits+releases+release-groups`);for(const rel of (r.releases||[]).slice(0,6)){const a=await mbLoadRelease(rel.id,input,evidence,'MusicBrainz URL + YouTube Art Track',55);if(a)out.push(a);await sleep(110)}}catch(e){evidence.errors.push(`mb-rel:${e.message}`)}}
  try{const query=`recording:${JSON.stringify(input.title)} AND artist:${JSON.stringify(input.artist)}`;const j=await mbGet(`recording/?query=${encodeURIComponent(query)}&limit=8`);const recs=(j.recordings||[]).map(r=>({r,pre:sim(r.title,input.title)*55+sim(mbArtist(r['artist-credit']),input.artist)*30+(durationScore(r.length,input.durationMs)>0?durationScore(r.length,input.durationMs)*15:0)})).filter(x=>x.pre>=48).sort((a,b)=>b.pre-a.pre).slice(0,5);for(const {r,pre} of recs){for(const rel of (r.releases||[]).slice(0,5)){if(out.some(x=>x.id===rel.id))continue;const a=await mbLoadRelease(rel.id,input,evidence,'MusicBrainz Deep',Math.min(35,pre*.22));if(a)out.push(a);await sleep(110);}}}catch(e){evidence.errors.push(`mb-deep:${e.message}`)}
  return dedupe(out,x=>x.id).sort((a,b)=>b.score-a.score).slice(0,7);
}
function dedupe(a,key){const m=new Map();for(const x of a||[]){const k=key(x);if(k&&!m.has(k))m.set(k,x)}return [...m.values()];}

function sameFamily(a,b){if(!a||!b)return false;const af=family(a.title),bf=family(b.title);return sim(af,bf)>=.74&&sim(a.artist,b.artist)>=.38;}
function sourceWeight(s){return ({youtube_music:1.35,deezer:1.25,apple:1.20,musicbrainz:1.15}[s]||1);}
function chooseRepresentative(group,input,evidence){const hint=evidence.albumHint;const ordered=[...group].sort((a,b)=>{
  const ap=badEditionPenalty(a.title,input.title,hint),bp=badEditionPenalty(b.title,input.title,hint);
  if(ap!==bp)return ap-bp;
  if((a.trackCount>1)!==(b.trackCount>1))return b.trackCount-a.trackCount;
  if(a.year&&b.year&&a.year!==b.year)return a.year-b.year;
  return b.score-a.score;
});return ordered[0];}
function consensus(candidates,input,evidence){const valid=candidates.filter(a=>a?.title&&a?.artist&&a.trackCount>0&&a.score>35);const groups=[];for(const c of valid){let g=groups.find(g=>g.some(x=>sameFamily(x,c)));if(!g){g=[];groups.push(g)}g.push(c)}
