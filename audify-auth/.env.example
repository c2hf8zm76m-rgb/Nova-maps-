# Never commit real values or the Apple .p8 private key.
AUDIFY_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUDIFY_APPLE_SERVICE_ID=com.example.audify.service
AUDIFY_APPLE_REDIRECT_URI=https://your-auth-domain.example/api/apple/callback
AUDIFY_APPLE_TEAM_ID=XXXXXXXXXX
AUDIFY_APPLE_KEY_ID=XXXXXXXXXX
AUDIFY_APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
